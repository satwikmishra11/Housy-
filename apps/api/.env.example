# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgres://housy_user:housy_password@localhost:5432/housy_db

# Logging
LOG_LEVEL=info

# Authentication & Session Secrets (Change in Production!)
JWT_SECRET=housy-dev-jwt-secret-min-32-chars-long!
SESSION_SECRET=housy-dev-session-secret-min-32-chars-long!
COOKIE_SECURE=false

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_CHAT_WINDOW_MS=60000

