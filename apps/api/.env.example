# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgres://housy_user:housy_password@localhost:5432/housy_db

# Logging
LOG_LEVEL=info

# Authentication & Session Secrets (Change in Production! Never use default keys)
JWT_SECRET=housy-dev-jwt-secret-min-32-chars-long!
SESSION_SECRET=housy-dev-session-secret-min-32-chars-long!
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_CHAT_WINDOW_MS=60000

# Demo & Background Job Configuration
DEMO_MODE=true
INTERNAL_API_KEY=housy-internal-cron-key-12345

# LLM Provider Configuration
# Supported providers in production: anthropic | gemini (mock is restricted to NODE_ENV=test)
LLM_PROVIDER=

# Current Model IDs:
# Google Gemini: gemini-3.8-flash, gemini-2.5-pro, gemini-flash-latest, or gemini-2.5-flash-lite
# Anthropic: claude-3-5-sonnet-20241022 or claude-3-5-haiku-20241022
# Note: LLM_MODEL has no default and must be explicitly specified when using a real provider.
LLM_MODEL=

# API Credentials (provide the key for the selected provider)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

LLM_TIMEOUT_MS=20000

# SPENDING CAP REMINDER: Configure daily call cap and set hard billing alerts in Google Cloud / Anthropic Console
LLM_DAILY_MESSAGE_CAP=1000
