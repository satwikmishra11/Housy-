# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgres://housy_user:housy_password@localhost:5432/housy_db
TEST_DATABASE_URL=postgres://housy_user:housy_password@localhost:5432/housy_test

# Logging
LOG_LEVEL=info

# Authentication & Session Secrets (Change in Production! Never use default keys)
JWT_SECRET=housy-dev-jwt-secret-min-32-chars-long!
SESSION_SECRET=housy-dev-session-secret-min-32-chars-long!
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_CHAT_WINDOW_MS=60000

# Demo & Background Job Configuration
DEMO_MODE=true
INTERNAL_API_KEY=housy-internal-cron-key-12345

# LLM Provider Configuration (Required for live AI chat answers)
# Choose one provider: 'gemini' or 'anthropic' (mock is restricted to NODE_ENV=test)
LLM_PROVIDER=gemini

# Explicit model ID for the selected provider (e.g. gemini-2.5-flash or claude-3-5-sonnet-20241022)
LLM_MODEL=gemini-2.5-flash

# API Credentials (provide the key for the selected provider)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

LLM_TIMEOUT_MS=20000

# SPENDING CAP REMINDER: Configure daily call cap and set hard billing alerts in Google Cloud / Anthropic Console
LLM_DAILY_MESSAGE_CAP=1000
