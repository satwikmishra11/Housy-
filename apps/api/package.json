{
  "name": "@housy/api",
  "version": "1.0.0",
  "private": true,
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "prebuild": "npm run build --workspace=@housy/shared",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=index.js --external:argon2 --footer:js=\"module.exports = app; module.exports.default = app; module.exports.app = app; module.exports.createApp = createApp;\"",
    "pretypecheck": "npm run build --workspace=@housy/shared",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node index.js",
    "test": "vitest run",
    "eval:ai": "tsx evals/eval-runner.ts --provider=mock",
    "eval:ai:live": "tsx evals/eval-runner.ts --provider=live",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:demo": "DEMO_MODE=true tsx src/db/seed.ts",
    "seed:demo": "DEMO_MODE=true node dist/db/seed.js",
    "db:reset": "tsx src/db/reset.ts",
    "db:test:reset": "NODE_ENV=test tsx src/db/reset.ts",
    "release": "node-pg-migrate up",
    "migrate:create": "node-pg-migrate create",
    "migrate:up": "node-pg-migrate up --envPath .env",
    "migrate:down": "node-pg-migrate down --envPath .env"
  },
  "dependencies": {
    "@housy/shared": "*",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.0",
    "js-yaml": "^5.5.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
