{
  "name": "housy-monorepo",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Production-quality full-stack TypeScript platform for Company A",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace=@housy/api",
    "dev:web": "npm run dev --workspace=@housy/web",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate:up --workspace=@housy/api",
    "db:seed": "npm run db:seed --workspace=@housy/api",
    "db:reset": "npm run db:reset --workspace=@housy/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  }
}

