{
  "name": "housy-monorepo",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Production-quality full-stack TypeScript platform for Company A",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=@housy/shared",
    "build:api": "npm run build --workspace=@housy/api",
    "build:web": "npm run build --workspace=@housy/web",
    "start": "npm run start --workspace=@housy/api",
    "release": "npm run build --workspace=@housy/shared && npm run build --workspace=@housy/api && npm run release --workspace=@housy/api",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "stats": "node scripts/doc-stats.mjs",
    "check:doc-stats": "node scripts/doc-stats.mjs --check",
    "typecheck": "npm run build --workspace=@housy/shared && npm run typecheck --workspaces --if-present",
    "eval:ai": "npm run eval:ai --workspace=@housy/api",
    "eval:ai:live": "npm run eval:ai:live --workspace=@housy/api",
    "capture:transcripts": "tsx scripts/capture-transcripts.ts",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace=@housy/api",
    "dev:web": "npm run dev --workspace=@housy/web",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate:up --workspace=@housy/api",
    "db:seed": "npm run db:seed --workspace=@housy/api",
    "db:seed:demo": "npm run db:seed:demo --workspace=@housy/api",
    "db:reset": "npm run db:reset --workspace=@housy/api",
    "db:test:reset": "npm run db:test:reset --workspace=@housy/api",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepare": "npm run build:shared && husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.21.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4",
    "tinypool": "^2.2.0",
    "zod": "^3.24.4"
  }
}
